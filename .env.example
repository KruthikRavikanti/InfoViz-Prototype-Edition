# Cortex Core serves temporary comparison-session JSON and uploaded images.
# The relative URL works through the Vite proxy with one forwarded browser port.
VITE_CORTEX_CORE_URL=/cortex-core
CORTEX_CORE_PROXY_TARGET=http://127.0.0.1:5556
# Mount below Cortex App's single browser-visible port in Remote SSH setups.
VITE_INFOVIZ_BASE_PATH=/infoviz/

# Used only by the invalid/expired-session return link.
VITE_CORTEX_APP_URL=http://localhost:5173
